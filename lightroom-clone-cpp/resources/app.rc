// Silver Halide application resources.
// The relative path resolves against this file's own directory (resources/),
// where icons/app.ico lives, keeping the script free of absolute paths.
IDI_APP_ICON ICON "icons/app.ico"

#define APP_VERSION_STR "2.11.0"

1 VERSIONINFO
FILEVERSION    2,11,0,0
PRODUCTVERSION 2,11,0,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         0x40004L            // Windows NT
FILETYPE       0x1L                // application
FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"           // English (US), Unicode
        BEGIN
            VALUE "CompanyName",      "ASE-128"
            VALUE "FileDescription",  "Silver Halide"
            VALUE "FileVersion",      APP_VERSION_STR
            VALUE "InternalName",     "SilverHalide"
            VALUE "LegalCopyright",   "©ASE-128 2026"
            VALUE "OriginalFilename", "SilverHalide.exe"
            VALUE "ProductName",      "Silver Halide"
            VALUE "ProductVersion",   APP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
